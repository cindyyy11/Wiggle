# Server-only upstream for the same-origin mission proxy. Leave blank for local play.
WIGGLE_API_URL=
# Optional direct browser override; this endpoint must configure browser CORS.
NEXT_PUBLIC_API_URL=
# Browser-safe Supabase Auth configuration. Both must be present or both absent.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required in Supabase API mode: SQLite file on a persistent, private single-host volume.
WIGGLE_PIN_STORE_PATH=

# Server-only credentials. Never expose SUPABASE_SERVICE_ROLE_KEY to apps/web.
WIGGLE_REPOSITORY_BACKEND=memory
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
WIGGLE_AI_PROVIDER=local
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=5
