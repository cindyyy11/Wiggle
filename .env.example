# Public browser endpoint for the FastAPI service. Leave blank to use local fallbacks.
NEXT_PUBLIC_API_URL=

# Server-only credentials. Never expose SUPABASE_SERVICE_ROLE_KEY to apps/web.
WIGGLE_REPOSITORY_BACKEND=memory
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
WIGGLE_AI_PROVIDER=local
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=5
