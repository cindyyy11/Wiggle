{
  "name": "wiggle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.x",
    "npm": ">=11.6.2 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api \"npm run dev --workspace=@wiggle/web\" \"npm run api:dev\"",
    "test": "turbo run test && npm run api:test",
    "lint": "turbo run lint && npm run api:lint",
    "typecheck": "turbo run typecheck && npm run api:typecheck",
    "build": "turbo run build",
    "test:e2e": "npm run test:e2e --workspace=@wiggle/web",
    "api:dev": "node scripts/api-dev.mjs",
    "api:test": "cd apps/api && python -m pytest -v",
    "api:lint": "cd apps/api && ruff check .",
    "api:typecheck": "cd apps/api && mypy app"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "22.15.30",
    "concurrently": "9.2.1",
    "eslint": "9.34.0",
    "turbo": "2.5.6",
    "typescript": "5.8.3",
    "typescript-eslint": "8.39.0"
  }
}
