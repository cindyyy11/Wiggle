{
  "name": "wiggle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api \"pnpm --filter @wiggle/web dev\" \"pnpm run api:dev\"",
    "test": "turbo run test && pnpm run api:test",
    "lint": "turbo run lint && pnpm run api:lint",
    "typecheck": "turbo run typecheck && pnpm run api:typecheck",
    "build": "turbo run build",
    "test:e2e": "pnpm --filter @wiggle/web test:e2e",
    "api:dev": "node scripts/api-dev.mjs",
    "api:test": "cd apps/api && python -m pytest -v",
    "api:lint": "cd apps/api && ruff check .",
    "api:typecheck": "cd apps/api && mypy app"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "22.15.30",
    "concurrently": "9.2.1",
    "eslint": "9.34.0",
    "turbo": "2.5.6",
    "typescript": "5.8.3",
    "typescript-eslint": "8.39.0"
  }
}
